# Copy to .env and fill in to enable real Zoom / Google Meet meeting sync and Gmail sync.
# Without these, the Meetings/Knowledge Base pages still work — the Connect buttons just
# show "not configured" instead of erroring. See docs/use-cases/meetings/backend.md and
# docs/use-cases/knowledge-base/backend.md.

# Zoom OAuth app (https://marketplace.zoom.us/develop/create) — General App, OAuth type.
# Needs the meeting:read:list_meetings scope, and recording:read:list_user_recordings if
# you also want Zoom cloud recording sync.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:4000/api/integrations/zoom/callback

# Google Cloud OAuth client (https://console.cloud.google.com/apis/credentials) — Web
# application type. Shared by all three Google flows below (same client id/secret, separate
# redirect URIs and scopes, so a user can grant one without the others): enable the Google
# Calendar API for Meet sync, the Gmail API for email sync, and (for login) add each of
# GOOGLE_REDIRECT_URI / GMAIL_REDIRECT_URI / GOOGLE_LOGIN_REDIRECT_URI as an authorized
# redirect URI on the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback
GMAIL_REDIRECT_URI=http://localhost:4000/api/integrations/gmail/callback

# "Continue with Google" / "Continue with SSO" on the login page — reuses the same OAuth
# client above with an 'openid email profile' scope (identity, not a data-access grant like
# the two above). Without this configured, both buttons show "not configured" instead of
# starting a broken OAuth flow. See docs/use-cases/landing-login/backend.md.
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Where to redirect back to after the OAuth round trip.
FRONTEND_URL=http://localhost:5173

# Neon (Postgres) connection string — required. From the Neon project dashboard
# ("Connection string" on the project overview page). Must include sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Neo4j Aura — optional, graph-expanded retrieval for Ask The Record (see
# docs/use-cases/ask-the-record/backend.md). Without these, Ask The Record still works exactly
# as before (pure keyword search) — every graph read/write degrades to a silent no-op rather
# than erroring, same "not configured" tolerance as the Zoom/Google integrations above. From
# your Aura console: Connection URI (starts with neo4j+s://), and the username/password shown
# once when the instance was created.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Gemini API key — required for Ask The Record's chat agent (see
# docs/use-cases/ask-the-record/backend.md). From https://aistudio.google.com/apikey
# ("Get API key" → "Create API key"). Without this, POST /api/chat/ask fails outright —
# unlike the integrations above, chat has no "not configured" degrade path.
GEMINI_API_KEY=

# Restricts new-account creation (password signup and first-time Google sign-in) to this email
# domain — see server/src/routes/auth.ts's isAllowedSignupDomain(). Logging into an existing
# account is never affected, only the creation of a brand-new one. Optional — unset means any
# domain can sign up and get its own new org, the original behavior.
ALLOWED_SIGNUP_DOMAIN=

# --- Production deployment only (e.g. Vercel) — leave both unset for local dev ---

# Comma-separated list of allowed frontend origins for CORS, e.g.
# https://the-record.vercel.app,https://the-record-git-main.vercel.app
# Unset falls back to the local Vite dev origins (localhost:5173/4173) — see src/app.ts.
CORS_ORIGINS=

# Enables Vercel Blob for file uploads (avatars, meeting assets, project docs, synced Zoom
# recordings) — see src/storage.ts. Required once deployed to Vercel: the serverless filesystem
# is ephemeral, so local-disk storage (this app's default, and everything below) silently loses
# every uploaded file otherwise. Get one by adding Vercel Blob to the project in the Vercel
# dashboard (Storage tab) — it fills this in for you as a linked environment variable. Unset
# means local disk, exactly today's behavior — safe to leave empty for local dev and any host
# with a real persistent filesystem (Railway, Render, a VPS).
BLOB_READ_WRITE_TOKEN=

# Alternative to Vercel Blob above: set to exactly "postgres" to store uploaded files as rows in
# the file_blobs table (src/db.ts) instead of Vercel Blob or local disk - see src/storage.ts.
# Avoids a second external dependency beyond Neon, at the cost of bloating Postgres storage/WAL
# with binary data - a reasonable fit for avatars and project documents, a poor one for large
# meeting recordings. If both this and BLOB_READ_WRITE_TOKEN are set, Blob takes priority. Unset
# means local disk (the default described above).
FILE_STORAGE=
